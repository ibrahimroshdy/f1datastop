# ─── Supabase (required) ────────────────────────────────────────────────────
# Project → Settings → API. The publishable/anon key is safe to ship to the
# browser (RLS-protected); never put the service_role key in frontend env.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# ─── AdSense (optional) ─────────────────────────────────────────────────────
# Units render only when a slot id is set. Create Display ad units in AdSense →
# Ads → Ad units → Display, then copy each numeric "Ad slot".
# CMP / brand safety are configured in the AdSense dashboard, not in code.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_TOP_IN_CONTENT=
VITE_ADSENSE_SLOT_BOTTOM_IN_CONTENT=
VITE_ADSENSE_SLOT_SIDEBAR=

# ─── Analytics (optional — disabled when unset) ─────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# ─── Maps (optional) ────────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=

# ─── reCAPTCHA (optional — site key is public) ──────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ─── F1 API proxy (optional) ────────────────────────────────────────────────
# When true, Ergast/OpenF1 requests go through the Supabase f1-proxy edge
# function (server-side cache). Requires VITE_SUPABASE_* above.
# Dev default: direct / Vite proxy. Production: enable after deploying f1-proxy.
VITE_F1_PROXY_ENABLED=false

# ─── F1 upstream bases (optional overrides) ─────────────────────────────────
# VITE_ERGAST_BASE=/api/ergast
# VITE_OPENF1_BASE=/api/openf1

# ─── Supabase Edge Function secrets (NOT frontend) ──────────────────────────
# Set via: supabase secrets set NAME=value
#   SLACK_WEBHOOK_URL       — Slack Incoming Webhook for signup notifier (notify-slack)
#   RECAPTCHA_SECRET_KEY    — Google reCAPTCHA secret for captcha-verify
#   SUPABASE_SERVICE_ROLE_KEY — auto-injected; used by edge functions
