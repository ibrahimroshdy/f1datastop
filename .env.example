# F1 DataStop — environment variables
# Copy to web/.env.local (or repo root .env.local) and fill in values.
# Integrations are optional: leave blank to disable GA4, Clarity, AdSense, etc.

# ═══════════════════════════════════════════════════════════════════════════
# Frontend (Vite — all prefixed VITE_)
# Loaded from web/.env.local when running `npm run dev` in web/
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase (required) ────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Publishable/anon key is safe in the browser (RLS). Never put service_role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# ─── F1 API proxy (optional) ────────────────────────────────────────────────
# true → Ergast/OpenF1 via Supabase f1-proxy edge function + Postgres cache.
# Requires VITE_SUPABASE_* and deployed f1-proxy + api_cache migration.
VITE_F1_PROXY_ENABLED=false

# Same-origin rewrites on Vercel (optional; avoids CORS without shared cache):
# VITE_ERGAST_BASE=/api/ergast
# VITE_OPENF1_BASE=/api/openf1

# ─── Google Analytics 4 (optional) ──────────────────────────────────────────
# Admin → Data streams → Measurement ID (G-XXXXXXXX)
# When unset: no gtag script, all GA4 helpers no-op.
VITE_GA_MEASUREMENT_ID=

# ─── Microsoft Clarity (optional) ───────────────────────────────────────────
# Clarity project → Settings → Overview → Project ID
# When unset: ClarityProvider and clarity helpers no-op.
VITE_CLARITY_PROJECT_ID=

# ─── Google AdSense (optional) ──────────────────────────────────────────────
# AdSense → Account → Publisher ID (ca-pub-…)
# Create Display ad units → copy numeric slot IDs per placement.
# When client id unset: no adsbygoogle.js, AdSenseUnit returns null.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_TOP_IN_CONTENT=
VITE_ADSENSE_SLOT_BOTTOM_IN_CONTENT=
VITE_ADSENSE_SLOT_SIDEBAR=

# ─── reCAPTCHA v3 (optional) ─────────────────────────────────────────────────
# Google reCAPTCHA admin → site key (public). Secret stays in edge function.
# When unset: signup skips captcha UI and server verify.
VITE_RECAPTCHA_SITE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Supabase Edge Function secrets (server only — NOT VITE_)
# Set via: supabase secrets set NAME=value
# ═══════════════════════════════════════════════════════════════════════════

# notify-slack — Slack Incoming Webhook URL; no-op when unset (verify_jwt: true)
# SLACK_WEBHOOK_URL=

# captcha-verify — reCAPTCHA secret key (pairs with VITE_RECAPTCHA_SITE_KEY)
# RECAPTCHA_SECRET_KEY=

# Auto-injected by Supabase runtime (do not set manually in .env):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# ─── Web Push notifications (optional) ──────────────────────────────────────
# Generate a keypair: npx web-push generate-vapid-keys
# Frontend (public key — safe in browser):
VITE_VAPID_PUBLIC_KEY=
# Edge function secrets (supabase secrets set NAME=value) for send-push:
#   VAPID_PUBLIC_KEY   — same public key as VITE_VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY  — the private key (NEVER ship to the browser)
#   PUSH_ADMIN_TOKEN   — shared secret guarding the send-push endpoint
